---
source: crates/skm-cli/tests/v1.rs
expression: json
---
$ skm list --json
[
  {
    "description": "Review code",
    "kind": "skill",
    "name": "review"
  }
]

$ skm list --kind skill --scope global --json
[]

$ skm show review --json
{
  "active": [],
  "description": "Review code",
  "kind": "skill",
  "metadata": {
    "allowed-tools": null,
    "compatibility": null,
    "description": "Review code",
    "license": null,
    "metadata": {},
    "name": "review"
  },
  "name": "review",
  "path": "<ROOT>/manager/library/skills/review",
  "problems": [],
  "source": null
}

$ skm status --json
{
  "agents": [],
  "items": 1,
  "pending": 0,
  "pending_updates": 0,
  "projects": [
    {
      "auto_sync": true,
      "id": 2,
      "mode": "copy",
      "name": "project",
      "path": "<ROOT>/project"
    }
  ]
}

$ skm set list --json
{
  "toolkit": {
    "skills": [
      "review"
    ]
  }
}

$ skm set show toolkit --json
{
  "skills": [
    "review"
  ]
}

$ skm project list --json
[
  {
    "auto_sync": true,
    "id": 2,
    "mode": "copy",
    "name": "project",
    "path": "<ROOT>/project"
  }
]

$ skm doctor --json
{
  "cache": "<ROOT>/manager/cache",
  "config": "<ROOT>/manager/config.toml",
  "db": "<ROOT>/manager/state.db",
  "home": "<ROOT>/manager",
  "library": "<ROOT>/manager/library",
  "lock": "<ROOT>/manager/lock",
  "logs": "<ROOT>/manager/logs",
  "trash": "<ROOT>/manager/trash"
}
